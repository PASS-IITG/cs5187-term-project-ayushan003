From 6de23539e5d5efe840838198ac2235e2e47f4231 Mon Sep 17 00:00:00 2001
From: ayushan003 <ayush.chauhan@iitg.ac.in>
Date: Sun, 1 Nov 2026 17:35:12 +0530
Subject: [PATCH] core/functions: check the requested length before allocating
 in lpad/rpad/repeat
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

lpad, rpad and repeat sized their result from the caller's argument and
allocated it directly, so a length near i64::MAX aborted the whole process in
the allocator:

    $ tursodb :memory: "select lpad('a', 9223372036854775807, 'b')"
    memory allocation of 9223372036854775806 bytes failed
    Aborted

The length limit was already enforced, but only after the result existed, so it
caught lpad('a', 4294967296, 'b') - where the allocation fails gracefully - and
never ran for larger arguments. These functions now compare the requested
length against Value::MAX_BLOB_LENGTH first and return LimboError::TooBig,
which is the same "string or blob too big" (code 18) the existing check
produces. repeat multiplies, so it uses checked_mul and refuses on overflow.

All three now report the error instead of aborting, and the boundary cases keep
working:

    select lpad('a', 9223372036854775807, 'b');  -- string or blob too big (18)
    select rpad('a', 9223372036854775807, 'b');  -- string or blob too big (18)
    select repeat('a', 9223372036854775807);     -- string or blob too big (18)
    select lpad('abc', 6, 'xy');                 -- xyxabc
    select lpad('aéc', 4);                       --  aéc

Fixes #11219.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 core/functions/string.rs | 143 ++++++++++++++++++++++++++++-----------
 core/vdbe/execute.rs     |   6 +-
 2 files changed, 108 insertions(+), 41 deletions(-)

diff --git a/core/functions/string.rs b/core/functions/string.rs
index 1c811246b..829833241 100644
--- a/core/functions/string.rs
+++ b/core/functions/string.rs
@@ -5,96 +5,113 @@
 //! matching the PG contract.
 
 use crate::types::Value;
+use crate::{LimboError, Result};
 
 /// `repeat(string, n)` — return `string` concatenated `n` times. Returns NULL
 /// for NULL input or NULL count. `n <= 0` produces an empty string (matches
 /// PG; SQLite's analogue isn't built-in).
-pub fn exec_repeat(input: &Value, count: &Value) -> Value {
+pub fn exec_repeat(input: &Value, count: &Value) -> Result<Value> {
     let s = match input {
-        Value::Null => return Value::Null,
+        Value::Null => return Ok(Value::Null),
         Value::Text(t) => t.as_str().to_owned(),
         v => v.to_string(),
     };
     let n = match count {
-        Value::Null => return Value::Null,
+        Value::Null => return Ok(Value::Null),
         Value::Numeric(crate::Numeric::Integer(i)) => *i,
         Value::Numeric(crate::Numeric::Float(f)) => {
             let f: f64 = (*f).into();
             f as i64
         }
         Value::Text(t) => t.as_str().parse::<i64>().unwrap_or(0),
-        _ => return Value::Null,
+        _ => return Ok(Value::Null),
     };
     if n <= 0 {
-        return Value::build_text(String::new());
+        return Ok(Value::build_text(String::new()));
     }
-    Value::build_text(s.repeat(n as usize))
+    // Refuse before allocating. `s.repeat(n)` asks for `s.len() * n` bytes up
+    // front, so a large `n` aborted the process in the allocator instead of
+    // raising an error the statement could report.
+    let total = (s.len() as i64).checked_mul(n);
+    if total.is_none_or(|bytes| bytes > Value::MAX_BLOB_LENGTH) {
+        return Err(LimboError::TooBig);
+    }
+    Ok(Value::build_text(s.repeat(n as usize)))
 }
 
 /// `lpad(string, length [, fill])` — left-pad `string` with `fill` (default
 /// space) so the result is exactly `length` characters. If `string` already
 /// has `length` or more characters, it is truncated from the right.
-pub fn exec_lpad(input: &Value, length: &Value, fill: Option<&Value>) -> Value {
+pub fn exec_lpad(input: &Value, length: &Value, fill: Option<&Value>) -> Result<Value> {
     pad(input, length, fill, /* on_left */ true)
 }
 
 /// `rpad(string, length [, fill])` — right-pad `string` with `fill` (default
 /// space) to exactly `length` characters. Same truncation behaviour as
 /// [`exec_lpad`].
-pub fn exec_rpad(input: &Value, length: &Value, fill: Option<&Value>) -> Value {
+pub fn exec_rpad(input: &Value, length: &Value, fill: Option<&Value>) -> Result<Value> {
     pad(input, length, fill, /* on_left */ false)
 }
 
 /// Shared body for [`exec_lpad`] / [`exec_rpad`]. The only difference between
 /// the two is which side the padding goes on, so we route by a boolean to
 /// avoid duplicating the truncation, count, and fill-cycling logic.
-fn pad(input: &Value, length: &Value, fill: Option<&Value>, on_left: bool) -> Value {
+fn pad(input: &Value, length: &Value, fill: Option<&Value>, on_left: bool) -> Result<Value> {
     let s = match input {
-        Value::Null => return Value::Null,
+        Value::Null => return Ok(Value::Null),
         Value::Text(t) => t.as_str().to_owned(),
         v => v.to_string(),
     };
     let target_len = match length {
-        Value::Null => return Value::Null,
+        Value::Null => return Ok(Value::Null),
         Value::Numeric(crate::Numeric::Integer(i)) => *i,
         Value::Numeric(crate::Numeric::Float(f)) => {
             let f: f64 = (*f).into();
             f as i64
         }
         Value::Text(t) => t.as_str().parse::<i64>().unwrap_or(0),
-        _ => return Value::Null,
+        _ => return Ok(Value::Null),
     };
     if target_len <= 0 {
-        return Value::build_text(String::new());
+        return Ok(Value::build_text(String::new()));
+    }
+    // Refuse before allocating, for the same reason as `repeat` above: the
+    // padding below is built with `.take(target_len - char_count).collect()`,
+    // which reserves room for the whole result, so a large `target_len`
+    // aborted the process in the allocator rather than raising an error.
+    if target_len > Value::MAX_BLOB_LENGTH {
+        return Err(LimboError::TooBig);
     }
     let target_len = target_len as usize;
     let char_count = s.chars().count();
     if char_count >= target_len {
         // Truncate. lpad/rpad both trim from the right when over-length, per PG.
-        return Value::build_text(s.chars().take(target_len).collect::<String>());
+        return Ok(Value::build_text(
+            s.chars().take(target_len).collect::<String>(),
+        ));
     }
     // Pull the fill string (default space) and bail if it's empty: there's
     // nothing to repeat, so just return the input as-is.
     let fill_str = match fill {
         None => " ".to_string(),
-        Some(Value::Null) => return Value::Null,
+        Some(Value::Null) => return Ok(Value::Null),
         Some(Value::Text(t)) => t.as_str().to_owned(),
         Some(v) => v.to_string(),
     };
     let fill_chars: Vec<char> = fill_str.chars().collect();
     if fill_chars.is_empty() {
-        return Value::build_text(s);
+        return Ok(Value::build_text(s));
     }
     let pad: String = fill_chars
         .iter()
         .cycle()
         .take(target_len - char_count)
         .collect();
-    Value::build_text(if on_left {
+    Ok(Value::build_text(if on_left {
         format!("{pad}{s}")
     } else {
         format!("{s}{pad}")
-    })
+    }))
 }
 
 #[cfg(test)]
@@ -110,44 +127,44 @@ mod tests {
 
     #[test]
     fn repeat_basic() {
-        assert_eq!(exec_repeat(&t("ab"), &i(3)), t("ababab"));
-        assert_eq!(exec_repeat(&t("x"), &i(0)), t(""));
-        assert_eq!(exec_repeat(&t("x"), &i(-1)), t(""));
-        assert_eq!(exec_repeat(&t(""), &i(5)), t(""));
+        assert_eq!(exec_repeat(&t("ab"), &i(3)).unwrap(), t("ababab"));
+        assert_eq!(exec_repeat(&t("x"), &i(0)).unwrap(), t(""));
+        assert_eq!(exec_repeat(&t("x"), &i(-1)).unwrap(), t(""));
+        assert_eq!(exec_repeat(&t(""), &i(5)).unwrap(), t(""));
     }
 
     #[test]
     fn repeat_null() {
-        assert!(matches!(exec_repeat(&Value::Null, &i(3)), Value::Null));
-        assert!(matches!(exec_repeat(&t("x"), &Value::Null), Value::Null));
+        assert!(matches!(exec_repeat(&Value::Null, &i(3)).unwrap(), Value::Null));
+        assert!(matches!(exec_repeat(&t("x"), &Value::Null).unwrap(), Value::Null));
     }
 
     #[test]
     fn lpad_basic() {
-        assert_eq!(exec_lpad(&t("abc"), &i(6), None), t("   abc"));
-        assert_eq!(exec_lpad(&t("abc"), &i(6), Some(&t("xy"))), t("xyxabc"));
+        assert_eq!(exec_lpad(&t("abc"), &i(6), None).unwrap(), t("   abc"));
+        assert_eq!(exec_lpad(&t("abc"), &i(6), Some(&t("xy"))).unwrap(), t("xyxabc"));
         // Already long enough — truncate from the right.
-        assert_eq!(exec_lpad(&t("abcdef"), &i(3), None), t("abc"));
+        assert_eq!(exec_lpad(&t("abcdef"), &i(3), None).unwrap(), t("abc"));
         // Equal length — pass through.
-        assert_eq!(exec_lpad(&t("abc"), &i(3), Some(&t("x"))), t("abc"));
+        assert_eq!(exec_lpad(&t("abc"), &i(3), Some(&t("x"))).unwrap(), t("abc"));
     }
 
     #[test]
     fn rpad_basic() {
-        assert_eq!(exec_rpad(&t("abc"), &i(6), None), t("abc   "));
-        assert_eq!(exec_rpad(&t("abc"), &i(6), Some(&t("xy"))), t("abcxyx"));
-        assert_eq!(exec_rpad(&t("abcdef"), &i(3), None), t("abc"));
+        assert_eq!(exec_rpad(&t("abc"), &i(6), None).unwrap(), t("abc   "));
+        assert_eq!(exec_rpad(&t("abc"), &i(6), Some(&t("xy"))).unwrap(), t("abcxyx"));
+        assert_eq!(exec_rpad(&t("abcdef"), &i(3), None).unwrap(), t("abc"));
     }
 
     #[test]
     fn pad_null() {
-        assert!(matches!(exec_lpad(&Value::Null, &i(3), None), Value::Null));
+        assert!(matches!(exec_lpad(&Value::Null, &i(3), None).unwrap(), Value::Null));
         assert!(matches!(
-            exec_lpad(&t("x"), &Value::Null, None),
+            exec_lpad(&t("x"), &Value::Null, None).unwrap(),
             Value::Null
         ));
         assert!(matches!(
-            exec_lpad(&t("x"), &i(3), Some(&Value::Null)),
+            exec_lpad(&t("x"), &i(3), Some(&Value::Null)).unwrap(),
             Value::Null
         ));
     }
@@ -155,15 +172,65 @@ mod tests {
     #[test]
     fn pad_empty_fill_returns_input() {
         // PG: if fill is empty the result is the input unchanged.
-        assert_eq!(exec_lpad(&t("abc"), &i(10), Some(&t(""))), t("abc"));
-        assert_eq!(exec_rpad(&t("abc"), &i(10), Some(&t(""))), t("abc"));
+        assert_eq!(exec_lpad(&t("abc"), &i(10), Some(&t(""))).unwrap(), t("abc"));
+        assert_eq!(exec_rpad(&t("abc"), &i(10), Some(&t(""))).unwrap(), t("abc"));
     }
 
     #[test]
     fn pad_unicode_counts_characters_not_bytes() {
         // 'é' is 2 bytes in UTF-8 but one char. lpad/rpad pad to character
         // count, so a 3-char input needs 1 more char to reach length 4.
-        assert_eq!(exec_lpad(&t("aéc"), &i(4), None), t(" aéc"));
-        assert_eq!(exec_rpad(&t("aéc"), &i(4), None), t("aéc "));
+        assert_eq!(exec_lpad(&t("aéc"), &i(4), None).unwrap(), t(" aéc"));
+        assert_eq!(exec_rpad(&t("aéc"), &i(4), None).unwrap(), t("aéc "));
+    }
+
+    /// Regression tests for the allocator abort reported in #11219.
+    ///
+    /// Before the length check, `lpad`/`rpad`/`repeat` sized the result from
+    /// the caller's argument and allocated it directly, so a length near
+    /// `i64::MAX` aborted the whole process with "memory allocation of
+    /// 9223372036854775806 bytes failed" instead of raising an error. Without
+    /// the fix these tests do not fail — they abort the test runner.
+    #[test]
+    fn pad_rejects_a_length_over_the_limit() {
+        for n in [
+            i64::MAX,
+            Value::MAX_BLOB_LENGTH + 1,
+            4_294_967_296,
+        ] {
+            assert!(
+                matches!(exec_lpad(&t("a"), &i(n), Some(&t("b"))), Err(LimboError::TooBig)),
+                "lpad should refuse length {n}"
+            );
+            assert!(
+                matches!(exec_rpad(&t("a"), &i(n), Some(&t("b"))), Err(LimboError::TooBig)),
+                "rpad should refuse length {n}"
+            );
+        }
+    }
+
+    #[test]
+    fn repeat_rejects_a_count_that_overflows_the_limit() {
+        assert!(matches!(
+            exec_repeat(&t("a"), &i(i64::MAX)),
+            Err(LimboError::TooBig)
+        ));
+        assert!(matches!(
+            exec_repeat(&t("ab"), &i(Value::MAX_BLOB_LENGTH)),
+            Err(LimboError::TooBig)
+        ));
+    }
+
+    #[test]
+    fn pad_and_repeat_still_accept_lengths_at_the_limit() {
+        // The boundary itself must keep working, so the guard cannot be a
+        // blanket refusal of large-but-legal arguments.
+        assert_eq!(exec_lpad(&t("a"), &i(5), Some(&t("b"))).unwrap(), t("bbbba"));
+        assert_eq!(exec_rpad(&t("a"), &i(5), Some(&t("b"))).unwrap(), t("abbbb"));
+        assert_eq!(exec_repeat(&t("ab"), &i(3)).unwrap(), t("ababab"));
+        assert!(matches!(
+            exec_lpad(&t("a"), &i(Value::MAX_BLOB_LENGTH), Some(&t("b"))),
+            Ok(_)
+        ));
     }
 }
diff --git a/core/vdbe/execute.rs b/core/vdbe/execute.rs
index cc75cc1a6..7f74d4579 100644
--- a/core/vdbe/execute.rs
+++ b/core/vdbe/execute.rs
@@ -11186,7 +11186,7 @@ pub fn op_function(
                 let input = state.registers[*start_reg].get_value();
                 let count = state.registers[*start_reg + 1].get_value();
                 state.registers[*dest]
-                    .set_value(crate::functions::string::exec_repeat(input, count));
+                    .set_value(crate::functions::string::exec_repeat(input, count)?);
             }
             ScalarFunc::Lpad => {
                 let input = state.registers[*start_reg].get_value();
@@ -11197,7 +11197,7 @@ pub fn op_function(
                     None
                 };
                 state.registers[*dest]
-                    .set_value(crate::functions::string::exec_lpad(input, length, fill));
+                    .set_value(crate::functions::string::exec_lpad(input, length, fill)?);
             }
             ScalarFunc::Rpad => {
                 let input = state.registers[*start_reg].get_value();
@@ -11208,7 +11208,7 @@ pub fn op_function(
                     None
                 };
                 state.registers[*dest]
-                    .set_value(crate::functions::string::exec_rpad(input, length, fill));
+                    .set_value(crate::functions::string::exec_rpad(input, length, fill)?);
             }
             ScalarFunc::BooleanToInt => {
                 check_arg_count!(arg_count, 1);
-- 
