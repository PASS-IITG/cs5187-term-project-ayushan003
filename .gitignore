# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Build and fuzzing outputs (regenerated by scripts; never committed)
src/work/
*.profraw
*.profdata
out/
collected/

# Crash inputs stay private until upstream publishes a fix
crashes/
src/private/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Fuzzer artifacts dropped in the CWD by libFuzzer (never commit these)
crash-*
leak-*
timeout-*
oom-*
slow-unit-*
fuzz-*.log
