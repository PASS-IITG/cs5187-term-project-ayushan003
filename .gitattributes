# Scripts and sources must keep LF endings, even when checked out on Windows
# (CRLF breaks bash scripts run from WSL or Linux).
*.sh   text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.cc   text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
Makefile text eol=lf

# Generated artifacts: collapsed in GitHub diffs and excluded from language stats.
src/harnesses/**  linguist-generated=true
src/llm_cache/**  linguist-generated=true
src/results/**    linguist-generated=true
