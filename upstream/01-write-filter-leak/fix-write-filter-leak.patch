 }
@@ -463,6 +467,15 @@ archive_compressor_xz_close(struct archive_write_filter *f)
 static int
 archive_compressor_xz_free(struct archive_write_filter *f)
 {
+	struct xz *xz = f->data;
+
+	/* If the filter was left in the FATAL state, __archive_write_filters_close()
+	 * skipped archive_compressor_xz_close(), so the liblzma stream was never
+	 * ended. Release it here to avoid leaking the encoder state. */
+	if (xz != NULL && xz->stream_valid) {
+		xz->stream_valid = 0;
+		lzma_end(&(xz->stream));
+	}
 	free_data(f->data);
 	f->data = NULL;
 	return (ARCHIVE_OK);
