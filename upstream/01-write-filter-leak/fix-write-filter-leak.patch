 #endif
@@ -146,6 +147,17 @@ memerr:
 static int
 archive_compressor_gzip_free(struct archive_write_filter *f)
 {
+#ifdef HAVE_ZLIB_H
+	struct gzip *gzip = f->data;
+
+	/* If the filter was left in the FATAL state, archive_write_filters_close()
+	 * skipped archive_compressor_gzip_close(), so the zlib stream was never
+	 * ended. Release it here to avoid leaking the deflate state. */
+	if (gzip != NULL && gzip->stream_valid) {
+		deflateEnd(&(gzip->stream));
+		gzip->stream_valid = 0;
+	}
+#endif
 	free_data(f->data);
 	f->data = NULL;
 	return (ARCHIVE_OK);
